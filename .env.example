# Copy to .env and fill in real values. Never commit .env.

DATABASE_URL=postgresql://aml:CHANGE_ME@127.0.0.1:5432/aml_memory

# Bearer token the platform will use to call Add/Search.
MEMORY_API_KEY=CHANGE_ME_LONG_RANDOM

# Alibaba Cloud Bailian (DashScope) OpenAI-compatible endpoint.
EMBEDDING_API_KEY=CHANGE_ME
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMS=1024
EMBEDDING_BATCH_SIZE=10
EMBEDDING_CONCURRENCY=8
EMBEDDING_TIMEOUT_S=60

# Retrieval knobs
WINDOW_MESSAGES=6
RRF_K=60
NEIGHBOR_SEEDS=20
NEIGHBOR_RADIUS=1
NEIGHBOR_DECAY=0.35
TOP_K_MAX=100
MAX_ITEM_CHARS=4000
MAX_TOTAL_CHARS=350000
WINDOW_DATE_HEADER=false

# DB pool
DB_POOL_MIN=1
DB_POOL_MAX=20

SERVICE_NAME=aml-memory
SERVICE_VERSION=0.1.0
